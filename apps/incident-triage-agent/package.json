    "jose": "6.2.12",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.20.0",
    "eslint": "10.0.1",
    "mastra": "1.32.1",
    "prettier": "3.9.9",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
