{
  "name": "@mastra-agents/incident-triage-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "22.13.0",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "dev": "mastra dev",
    "lint": "eslint .",
    "format": "prettier --write .",
